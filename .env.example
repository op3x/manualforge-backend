# Anthropic Messages API key. Required to generate manuals.
ANTHROPIC_API_KEY=sk-ant-...
# Optional. Defaults to Claude Haiku 5.5 (claude-haiku-5-5).
ANTHROPIC_MODEL=claude-haiku-5-5

# Stripe. Prefer a restricted key (rk_). Read Charges, PaymentIntents, Invoices,
# Subscriptions, Prices, Products, Checkout Sessions, and Customers. Write
# PaymentIntents, Subscriptions, Checkout Sessions, and Billing Portal sessions.
# No Customers write. Read Invoice payments. The delivery stamp also writes
# Charges and Invoices. Checkout does not call customers.create. Starter uses
# customer_creation=always and does not pass customer. Integrator extra-manual
# and overage Checkouts may pass an existing customer id. They do not pass
# customer_update. A lost dispute cancels that subscription, with no proration,
# and does not block the customer from buying again. Run one replica.
# Put the real value in Railway variables, not in git.
STRIPE_SECRET_KEY=replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# HMAC key for subscription cancel links. Required for POST /access-link and
# for redeeming those links. No fallback to STRIPE_WEBHOOK_SECRET. If this is
# unset, those routes return 503. Never log the value.
PORTAL_TOKEN_SECRET=replace_me
# Billing Portal configuration (bpc_...). Required for the customer-portal
# cancel path. This Stripe account is shared with HTS Atlas. Create a
# configuration that includes only ManualOS products and put its id here.
# The account default portal is not used. Cancellation has to be enabled
# on that configuration.
# STRIPE_PORTAL_CONFIGURATION_ID=bpc_replace_me
# On only when the value is exactly 1. "true", "yes", and " 1 " are off.
# Shared with the Managed Payments checkout change via isManagedPayments().
# If the portal configuration is missing or a portal session cannot be
# created, /cancel shows https://app.link.com and plain steps. Email is only
# a backup. Startup warns when this is exactly 1 and
# STRIPE_PORTAL_CONFIGURATION_ID is unset.
# MANUALOS_MANAGED_PAYMENTS=1
# One-time $39 price id. Also set that Price's lookup_key to manualos_starter.
STRIPE_PRICE_STARTER=price_replace_me
# Recurring monthly $79 price id. Also set that Price's lookup_key to manualos_pro.
STRIPE_PRICE_PRO=price_replace_me
# Terms-of-service checkbox. Leave unset. Stripe rejects the session unless a
# terms of service URL is saved in the Dashboard. Set to 1 only after that.
# CHECKOUT_REQUIRE_TOS=1
# Server-side Terms and auto-renew consent. Leave unset until the frontend
# sends the checkboxes. Set to 1 after that ships. Until then, present consent
# is stored and a missing checkbox is allowed.
# CHECKOUT_REQUIRE_CONSENT=1

# Manuals included with a Starter payment. Default is 3.
STARTER_CREDITS=3

# Origin of the static site, no trailing slash.
# The process refuses to start in production when this is unset.
FRONTEND_URL=https://manualos.com

# Railway sets PORT. Local default is 3001.
PORT=3001

# Calendar date printed on the manual cover and revision table.
# Default is America/Chicago. A request field `date` (YYYY-MM-DD) overrides it.
MANUALOS_TZ=America/Chicago

# Phone and SMS support. Leave these unset to keep the routes inert (503 / keypad).
# Put real values in Railway, not in git. Never log them.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1
# SUPPORT_PHONE=+1
# ESCALATION_PHONE=+1
# Fallback email when an escalation text fails (toll-free verification can take ~2 weeks).
# ESCALATION_EMAIL=you@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=alerts@example.com
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# ManualOS half of the shared $20/month OpenAI budget.
# LLM_MONTHLY_BUDGET_USD=10
# PUBLIC_BASE_URL=https://manualforge-backend-production.up.railway.app
# Mount a Railway volume. The filesystem is ephemeral without one.
# Files: opt-outs.json, consents.jsonl, budget.json, threads.json, once.json, sms-notices.json.
# A toll-free TWILIO_FROM_NUMBER cannot text ESCALATION_PHONE until toll-free verification.
# SUPPORT_DATA_DIR=/data/support
# Unknown money events are appended to unknown-events.jsonl in this directory.
# DATA_DIR=/data
# SUPPORT_INTEGRATOR_ENABLED=false
