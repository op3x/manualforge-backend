<![CDATA[sfc_test = 1]]>
</Line>
</STContent>
</Condition>
</Transition>
<Stop ID="2" X="200" Y="300" Operand="Stop_000" HideDesc="false" DescX="280" DescY="280" DescWidth="0"/>
<DirectedLink FromID="0" ToID="1" Show="true"/>
<DirectedLink FromID="1" ToID="2" Show="true"/>
</SFCContent>
</Routine>
