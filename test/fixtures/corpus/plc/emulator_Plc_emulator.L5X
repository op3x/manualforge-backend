</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[MCR();]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[[SFR(SFC,Step_000) ,[XIC(ProgramControl.SFP_Pause) OTU(ProgramControl.SFP_Pause) SFP(SFC,Pause) ,XIC(ProgramControl.SFP_Execute) OTU(ProgramControl.SFP_Execute) SFP(SFC,Execute) ] ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
