<Rung Number="3" Type="N">
<Text>
<![CDATA[MOVE(5,ProgramControl.JSR_Input);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[JSR(Program_Control_JSR,1,ProgramControl.JSR_Input,ProgramControl.JSR_Output);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(ProgramControl.TND)TND();]]>
