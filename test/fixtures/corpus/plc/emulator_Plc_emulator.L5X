<Rung Number="12" Type="N">
<Text>
<![CDATA[[XIC(ProgramControl.EOT) OTL(ProgramControl.EOT_State) ,EOT(ProgramControl.EOT_State) OTE(ProgramControl.EOT_Status) ];]]>
