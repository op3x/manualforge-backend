<Routine Name="Timer_Counter" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(TimerCounter.TON_Run)MOVE(20000,TimerCounter.TON.PRE)TON(TimerCounter.TON,?,?);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(TimerCounter.TOF_Run)MOVE(20000,TimerCounter.TOF.PRE)TOF(TimerCounter.TOF,?,?);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(TimerCounter.RTO_Run)MOVE(20000,TimerCounter.RTO.PRE)RTO(TimerCounter.RTO,?,?);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(TimerCounter.CT_Up)CTU(TimerCounter.CT,?,?)OTU(TimerCounter.CT_Up);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(TimerCounter.CT_Down)CTD(TimerCounter.CT,?,?)OTU(TimerCounter.CT_Down);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(TimerCounter.Reset)OTU(TimerCounter.Reset)[RES(TimerCounter.TON) ,RES(TimerCounter.TOF) ,RES(TimerCounter.RTO) ,RES(TimerCounter.CT) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
