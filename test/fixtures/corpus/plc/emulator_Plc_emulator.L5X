<Routines>
<Routine Name="AOI" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[ladderAOI(ST_AOI,]]>
</Line>
<Line Number="1">
<![CDATA[ST_AOI_inout);]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
<Line Number="3">
<![CDATA[test_abs_out := ABS(LN(LOG(test_abs_in)));]]>
</Line>
<Line Number="4">
<![CDATA[]]>
</Line>
<Line Number="5">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
<Routine Name="CaseOF" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[case ST._CASE OF	]]>
</Line>
<Line Number="1">
<![CDATA[	1:]]>
</Line>
<Line Number="2">
<![CDATA[		ST.stringCase := '1';]]>
</Line>
<Line Number="3">
<![CDATA[	2,3,7..8,10 .. 15 :ST.stringCase := '2,3,7..8,10 .. 15';]]>
</Line>
<Line Number="4">
<![CDATA[		if (ST.test1]]>
</Line>
<Line Number="5">
<![CDATA[			AND ST.test2) then]]>
</Line>
<Line Number="6">
<![CDATA[				ST._AND := 1;]]>
</Line>
<Line Number="7">
<![CDATA[		end_if;]]>
</Line>
<Line Number="8">
<![CDATA[	else]]>
</Line>
<Line Number="9">
<![CDATA[		ST.stringCase := 'else';]]>
</Line>
<Line Number="10">
<![CDATA[end_case;]]>
</Line>
</STContent>
</Routine>
<Routine Name="ForDO" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[FOR ST.i := 0 TO 9 By 1 Do]]>
</Line>
<Line Number="1">
<![CDATA[	ST._FOR[ST.i] := ST.i;]]>
</Line>
<Line Number="2">
<![CDATA[	if ST.i = 5 then]]>
</Line>
<Line Number="3">
<![CDATA[		exit;]]>
</Line>
<Line Number="4">
<![CDATA[	end_if;]]>
</Line>
<Line Number="5">
<![CDATA[end_for;]]>
</Line>
</STContent>
</Routine>
<Routine Name="IFTest" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[ST._AND := 0;]]>
</Line>
<Line Number="1">
<![CDATA[ST._OR := 0;]]>
</Line>
<Line Number="2">
<![CDATA[ST.string :='';]]>
</Line>
<Line Number="3">
<![CDATA[]]>
</Line>
<Line Number="4">
<![CDATA[if 1 = 1 then]]>
</Line>
<Line Number="5">
<![CDATA[	ST._AND := 1;]]>
</Line>
<Line Number="6">
<![CDATA[end_if;]]>
</Line>
<Line Number="7">
<![CDATA[]]>
</Line>
<Line Number="8">
<![CDATA[if (ST.test1]]>
</Line>
<Line Number="9">
<![CDATA[	AND ST.test2) then]]>
</Line>
<Line Number="10">
<![CDATA[	ST._AND := 1;]]>
</Line>
<Line Number="11">
<![CDATA[elsif ST.test1]]>
</Line>
<Line Number="12">
<![CDATA[	OR ST.test2 then]]>
</Line>
<Line Number="13">
<![CDATA[	ST._OR := 1;]]>
</Line>
<Line Number="14">
<![CDATA[else]]>
</Line>
<Line Number="15">
<![CDATA[	ST.string :='All OFF';]]>
</Line>
<Line Number="16">
<![CDATA[end_if;]]>
</Line>
<Line Number="17">
<![CDATA[]]>
</Line>
<Line Number="18">
<![CDATA[sttimer.PRE := 10000;]]>
</Line>
<Line Number="19">
<![CDATA[TONR(ST.Timer );]]>
</Line>
<Line Number="20">
<![CDATA[ST.Timer.TimerEnable := ST.Timer_Run;]]>
</Line>
<Line Number="21">
<![CDATA[ST.Timer.Reset := not ST.Timer.TimerEnable;]]>
</Line>
</STContent>
</Routine>
<Routine Name="main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[JSR(IFTest,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(CaseOF,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[JSR(ForDO,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[JSR(WhileDO,0);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[JSR(AOI,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="WhileDO" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[while ST.while_test Do]]>
</Line>
<Line Number="1">
<![CDATA[	ST.while_test := 0;]]>
</Line>
<Line Number="2">
<![CDATA[end_while;]]>
</Line>
</STContent>
</Routine>
