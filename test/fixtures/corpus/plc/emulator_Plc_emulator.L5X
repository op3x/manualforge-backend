<Routine Name="Sequencer" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[XIC(Sequencer.SQI_Do) OTU(Sequencer.SQI_Do) SQI(Sequencer.Array,Sequencer.SQI_Mask,Sequencer.SQI_Source,Sequencer.SQI,?,?) ADD(Sequencer.SQI.POS,1,Sequencer.SQI.POS) ,GT(Sequencer.SQI.POS,Sequencer.SQI.LEN) MOVE(1,Sequencer.SQI.POS) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(Sequencer.SQO_Do)OTU(Sequencer.SQO_Do)SQO(Sequencer.Array,Sequencer.SQO_Mask,Sequencer.SQO_Source,Sequencer.SQO,?,?);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(Sequencer.SQL_Do)OTU(Sequencer.SQL_Do)SQL(Sequencer.Array,Sequencer.SQL_Source,Sequencer.SQL,?,?);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
